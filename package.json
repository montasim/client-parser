{
  "name": "client-parser-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "client-parser library and interactive documentation workspace.",
  "license": "MIT",
  "homepage": "https://client-parser.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montasim/client-parser.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/client-parser/issues"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter client-parser build && pnpm --filter @client-parser/web dev",
    "build": "pnpm --filter @client-parser/web... build",
    "build:parser": "pnpm --filter client-parser build",
    "build:web": "pnpm --filter @client-parser/web... build",
    "check": "pnpm check:parser && pnpm --filter @client-parser/web check",
    "check:parser": "pnpm --filter client-parser check",
    "check:web": "pnpm --filter client-parser build && pnpm --filter @client-parser/web check",
    "test": "pnpm --filter client-parser test",
    "test:coverage": "pnpm --filter client-parser test:coverage",
    "format": "pnpm --recursive --if-present format",
    "format:check": "pnpm --recursive --if-present format:check"
  }
}
